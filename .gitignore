# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment variables / secrets ---
.env
.env.*
!.env.example

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (raw/processed data should not be committed; keep folder structure via .gitkeep) ---
data/raw/*
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# --- Models / large artifacts ---
*.pkl
*.joblib
*.h5
*.pt
models/*.bin

# --- Logs ---
*.log
logs/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Frontend (Node/Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Docker ---
*.pid
